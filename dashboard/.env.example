# mainnet = real Ethereum-mainnet feeds + Maker state; OracleGuard modelled in the page (default)
# fork    = local anvil fork with OracleGuard deployed (Deploy + Spell), polled every 2s
VITE_MODE=mainnet
# optional mainnet RPC for mainnet mode (default https://ethereum-rpc.publicnode.com)
VITE_MAINNET_RPC_URL=
# anvil RPC for fork mode
VITE_RPC_URL=http://127.0.0.1:8545
